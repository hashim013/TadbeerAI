# Copy to .env and fill in keys (never commit .env)

# ==================== LLM PROVIDERS ====================
# gemini | groq — which LLM backend to use (auto-fallback to other if one fails)
AI_PROVIDER=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Groq Cloud - llama, mixtral models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROK_MODEL=grok-3-mini

# ==================== FIRESTORE (REAL PERSISTENCE) ====================
# Firebase service account JSON - obtain from Firebase Console
# Get from: Firebase Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key":"YOUR_PRIVATE_KEY","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL"}

# ==================== TWILIO SMS (REAL NOTIFICATIONS) ====================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# ==================== SENDGRID EMAIL (REAL NOTIFICATIONS) ====================
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@tadbeerai.com

# ==================== NOTIFICATION RECIPIENTS ====================
# Default recipients (can be overridden per action in core/notification_templates.py)
STAKEHOLDER_PHONE=+923001234567
STAKEHOLDER_EMAIL=stakeholder@company.pk

# ==================== EXTERNAL BUSINESS APIs (STUBS) ====================
# Fill in with your actual API endpoints for real integration
BILLING_API_URL=http://billing.internal/api
BILLING_API_KEY=

INVENTORY_API_URL=http://inventory.internal/api
INVENTORY_API_KEY=

ANALYTICS_API_URL=http://analytics.internal/api
ANALYTICS_API_KEY=

# ==================== SCHEDULING & CONFIG ====================
APP_ENV=development
POLL_INTERVAL_MINUTES=15
MAX_FEED_ITEMS=20

# Optional: override JSON cache directory (default ./data; on App Engine / Cloud Run uses /tmp/tadbeerai_data)
# DATA_DIR=/tmp/tadbeerai_data

